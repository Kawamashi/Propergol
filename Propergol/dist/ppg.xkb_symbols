// AltGr layer
// ╭╌╌╌╌╌┰─────┬─────┬─────┬─────┬─────┰─────┬─────┬─────┬─────┬─────┰╌╌╌╌╌┬╌╌╌╌╌╮
// ┆     ┃   ¹ │   ² │   ³ │   ⁴ │   ⁵ ┃   ⁶ │   ⁷ │   ⁸ │   ⁹ │   ⁰ ┃     ┆     ┆
// ┆   … ┃   ₁ │   ₂ │   ₃ │   ₄ │   ₅ ┃   ₆ │   ₇ │   ₈ │   ₉ │   ₀ ┃     ┆     ┆
// ╰╌╌╌╌╌╂─────┼─────┼─────┼─────┼─────╂─────┼─────┼─────┼─────┼─────╂╌╌╌╌╌┼╌╌╌╌╌┤
//       ┃   ¬ │     │     │   − │   @ ┃  *^ │  *¯ │  *˚ │  *¤ │  *` ┃     ┆     ┆
//       ┃   ! │   < │   > │   - │   ? ┃   ^ │   { │   } │   $ │   ` ┃   è ┆   ê ┆
//       ┠─────┼─────┼─────┼─────┼─────╂─────┼─────┼─────┼─────┼─────╂╌╌╌╌╌┼╌╌╌╌╌┤
//       ┃   ± │   × │   ÷ │   ≠ │  *˙ ┃  *ˇ │  *˘ │     │     │  *” ┃     ┆     ┆
//       ┃   + │   * │   / │   = │   . ┃   # │   ( │   ) │   ; │   " ┃   à ┆     ┆
// ╭╌╌╌╌╌╂─────┼─────┼─────┼─────┼─────╂─────┼─────┼─────┼─────┼─────╂╌╌╌╌╌┴╌╌╌╌╌╯
// ┆  *¯ ┃  *~ │   ‰ │  *, │  *˛ │  */ ┃     │   : │  *¸ │     │  *´ ┃
// ┆   _ ┃   ~ │   % │   [ │   ] │   \ ┃   @ │   : │   & │   | │   ' ┃
// ╰╌╌╌╌╌┸─────┴─────┴─────┴─────┴─────┸─────┴─────┴─────┴─────┴─────┚

partial alphanumeric_keys modifier_keys
xkb_symbols "Kawa" {
    name[group1]= "Propergol";
    key.type[group1] = "EIGHT_LEVEL";

    // Digits
    key <AE01> {[ 1               , EuroSign        , U2081           , onesuperior     , copyright       , cent            ]}; // 1 € ₁ ¹ © ¢
    key <AE02> {[ 2               , less            , U2082           , twosuperior     , onehalf         , VoidSymbol      ]}; // 2 < ₂ ² ½
    key <AE03> {[ 3               , greater         , U2083           , threesuperior   , onethird        , twothirds       ]}; // 3 > ₃ ³ ⅓ ⅔
    key <AE04> {[ 4               , dollar          , U2084           , U2074           , onequarter      , threequarters   ]}; // 4 $ ₄ ⁴ ¼ ¾
    key <AE05> {[ 5               , percent         , U2085           , U2075           , section         , U2030           ]}; // 5 % ₅ ⁵ § ‰
    key <AE06> {[ 6               , asciicircum     , U2086           , U2076           , paragraph       , U201A           ]}; // 6 ^ ₆ ⁶ ¶ ‚
    key <AE07> {[ 7               , ampersand       , U2087           , U2077           , cent            , U2018           ]}; // 7 & ₇ ⁷ ¢ ‘
    key <AE08> {[ 8               , bar             , U2088           , U2078           , infinity        , U2019           ]}; // 8 | ₈ ⁸ ∞ ’
    key <AE09> {[ 9               , numbersign      , U2089           , U2079           , trademark       , VoidSymbol      ]}; // 9 # ₉ ⁹ ™
    key <AE10> {[ 0               , at              , U2080           , U2070           , degree          , VoidSymbol      ]}; // 0 @ ₀ ⁰ °

    // Letters, first row
    key <AD01> {[ minus           , exclam          , exclam          , notsign         , VoidSymbol      , VoidSymbol      ]}; // - ! ! ¬
    key <AD02> {[ eacute          , Eacute          , less            , lessthanequal   , oe              , OE              ]}; // é É < ≤ œ Œ
    key <AD03> {[ u               , U               , greater         , greaterthanequal, ucircumflex     , Ucircumflex     ]}; // u U > ≥ û Û
    key <AD04> {[ p               , P               , minus           , U2212           , ugrave          , Ugrave          ]}; // p P - − ù Ù
    key <AD05> {[ comma           , question        , question        , at              , at              , questiondown    ]}; // , ? ? @ @ ¿
    key <AD06> {[ v               , V               , asciicircum     , dead_circumflex , U201E           , quotedbl        ]}; // v V ^ ^ „ "
    key <AD07> {[ m               , M               , braceleft       , dead_macron     , U201C           , guillemotleft   ]}; // m M { ˉ “ «
    key <AD08> {[ c               , C               , braceright      , dead_abovering  , U201D           , guillemotright  ]}; // c C } ˚ ” »
    key <AD09> {[ j               , J               , dollar          , dead_currency   , ae              , AE              ]}; // j J $ ¤ æ Æ
    key <AD10> {[ x               , X               , grave           , dead_grave      , U2011           , exclamdown      ]}; // x X ` ` ‑ ¡

    // Letters, second row
    key <AC01> {[ o               , O               , plus            , plusminus       , ocircumflex     , Ocircumflex     ]}; // o O + ± ô Ô
    key <AC02> {[ a               , A               , asterisk        , multiply        , acircumflex     , Acircumflex     ]}; // a A * × â Â
    key <AC03> {[ i               , I               , slash           , division        , icircumflex     , Icircumflex     ]}; // i I / ÷ î Î
    key <AC04> {[ n               , N               , equal           , notequal        , agrave          , Agrave          ]}; // n N = ≠ à À
    key <AC05> {[ period          , colon           , period          , dead_abovedot   , ellipsis        , periodcentered  ]}; // . : . ˙ … ·
    key <AC06> {[ g               , G               , numbersign      , dead_caron      , dead_greek      , VoidSymbol      ]}; // g G # ˇ µ
    key <AC07> {[ t               , T               , parenleft       , dead_breve      , slash           , VoidSymbol      ]}; // t T ( ˘ /
    key <AC08> {[ s               , S               , parenright      , VoidSymbol      , ccedilla        , Ccedilla        ]}; // s S )   ç Ç
    key <AC09> {[ r               , R               , semicolon       , VoidSymbol      , EuroSign        , VoidSymbol      ]}; // r R ;   €
    key <AC10> {[ l               , L               , quotedbl        , dead_doubleacute, sterling        , VoidSymbol      ]}; // l L " ˝ £

    // Letters, third row
    key <AB01> {[ q               , Q               , asciitilde      , dead_tilde      , VoidSymbol      , VoidSymbol      ]}; // q Q ~ ~
    key <AB02> {[ z               , Z               , percent         , U2030           , egrave          , Egrave          ]}; // z Z % ‰ è È
    key <AB03> {[ y               , Y               , bracketleft     , dead_belowcomma , idiaeresis      , Idiaeresis      ]}; // y Y [ , ï Ï
    key <AB04> {[ h               , H               , bracketright    , dead_ogonek     , ntilde          , Ntilde          ]}; // h H ] ˛ ñ Ñ
    key <AB05> {[ b               , B               , backslash       , dead_stroke     , parenleft       , braceleft       ]}; // b B \ / ( {
    key <AB06> {[ k               , K               , at              , VoidSymbol      , parenright      , braceright      ]}; // k K @   ) }
    key <AB07> {[ d               , D               , colon           , colon           , dead_diaeresis  , VoidSymbol      ]}; // d D : : ¨
    key <AB08> {[ f               , F               , ampersand       , dead_cedilla    , ssharp          , U1E9E           ]}; // f F & ¸ ß ẞ
    key <AB09> {[ w               , W               , bar             , brokenbar       , endash          , emdash          ]}; // w W | ¦ – —
    key <AB10> {[ ISO_Level5_Latch, semicolon       , apostrophe      , dead_acute      , VoidSymbol      , VoidSymbol      ]}; // ' ; ' ´

    // Pinky keys
    key <AE11> {[ slash           , asterisk        , VoidSymbol      , VoidSymbol      , division        , multiply        ]}; // / *     ÷ ×
    key <AE12> {[ equal           , backslash       , VoidSymbol      , VoidSymbol      , U2248           , notequal        ]}; // = \     ≈ ≠
    key <AE13> {[ VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      ]}; //
    key <AD11> {[ apostrophe      , quotedbl        , egrave          , Egrave          , leftarrow       , U21D0           ]}; // ' " è È ← ⇐
    key <AD12> {[ minus           , plus            , ecircumflex     , Ecircumflex     , U2212           , plusminus       ]}; // - + ê Ê − ±
    key <AC11> {[ underscore      , bracketleft     , agrave          , Agrave          , rightarrow      , U21D2           ]}; // _ [ à À → ⇒
    key <AB11> {[ VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      ]}; //
    key <TLDE> {[ grave           , asciitilde      , ellipsis        , VoidSymbol      , VoidSymbol      , VoidSymbol      ]}; // ` ~ …
    key <BKSL> {[ U2019           , bracketright    , VoidSymbol      , VoidSymbol      , U2194           , ifonlyif        ]}; // ’ ]     ↔ ⇔
    key <LSGT> {[ e               , E               , underscore      , dead_macron     , ecircumflex     , Ecircumflex     ]}; // e E _ ˉ ê Ê

    // Space bar
    key <SPCE> {[ space           , U202F           , space           , nobreakspace    , underscore      , underscore      ]}; //         _ _

    // The AltGr key is an ISO_Level3_Shift:
    include "level3(ralt_switch)"

    // The “OneDeadKey” is an ISO_Level5_Latch, which is activated by this:
    // (note: MDSW [Mode_switch] is an alias for LVL5 on recent versions of XKB)
    replace key <MDSW> {
        type[Group1] = "ONE_LEVEL",
        symbols[Group1] = [ ISO_Level5_Shift ]
    };
    modifier_map Mod3 { <MDSW> };
};
